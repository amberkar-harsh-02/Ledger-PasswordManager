<?xml version="1.0" encoding="utf-8"?>
<!--
    Security settings as grouped Material 3 lists: Protection, Autofill, Backup, Activity.
    Each row: icon, title, one-line explanation, and a switch or current value where relevant.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:text="@string/security_title"
            android:textAppearance="@style/TextAppearance.Ledger.HeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- Protection -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/security_group_protection" />

        <LinearLayout
            android:id="@+id/row_stealth_mode"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_visibility_off" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_hide_screen" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_hide_screen_summary" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_stealth_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:contentDescription="@string/security_hide_screen" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_auto_lock"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_schedule" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_auto_lock" />

                <TextView
                    android:id="@+id/text_auto_lock_status"
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    tools:text="Immediately" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_setup_duress"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_shield" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_duress" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_duress_summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Autofill -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/security_group_autofill" />

        <LinearLayout
            android:id="@+id/row_autofill"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_password" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_autofill" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_autofill_summary" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_autofill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:contentDescription="@string/security_autofill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_computers"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_computer" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_computers" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_computers_summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Backup -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/security_group_backup" />

        <LinearLayout
            android:id="@+id/btn_export_vault"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_upload" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_export" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_export_summary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_import_vault"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_download" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_import" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_import_summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Activity -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/security_group_activity" />

        <LinearLayout
            android:id="@+id/btn_reuse_scanner"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_search" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_reuse" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_reuse_summary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_audit_log"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_history" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/security_history" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/security_history_summary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
