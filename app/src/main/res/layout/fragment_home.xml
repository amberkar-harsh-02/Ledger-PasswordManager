<?xml version="1.0" encoding="utf-8"?>
<!--
    Home: greeting, the vault balance (one bar + counts), then the logins that need attention.
    Left aligned. The balance bar is the one bold element; everything else stays quiet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_6">

        <TextView
            android:id="@+id/textHeaderGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Ledger.HeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Good evening, Harsh" />

        <!-- Vault balance -->
        <TextView
            android:id="@+id/text_total_logins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:textAppearance="@style/TextAppearance.Ledger.Figure"
            android:textColor="?attr/colorOnSurface"
            tools:text="38 logins" />

        <com.example.passmanager.ui.main.VaultBalanceBar
            android:id="@+id/balance_bar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/space_3" />

        <LinearLayout
            android:id="@+id/balance_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:focusable="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_strong_count"
                style="@style/Widget.Ledger.LegendItem"
                app:drawableStartCompat="@drawable/legend_strong"
                tools:text="29 strong" />

            <TextView
                android:id="@+id/text_fair_count"
                style="@style/Widget.Ledger.LegendItem"
                app:drawableStartCompat="@drawable/legend_fair"
                tools:text="5 fair" />

            <TextView
                android:id="@+id/text_weak_count"
                style="@style/Widget.Ledger.LegendItem"
                app:drawableStartCompat="@drawable/legend_weak"
                tools:text="4 weak" />
        </LinearLayout>

        <!-- Needs attention -->
        <TextView
            android:id="@+id/text_attention_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:accessibilityHeading="true"
            android:text="@string/home_needs_attention"
            android:textAppearance="@style/TextAppearance.Ledger.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_attention_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Tap a login to change its password." />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_vulnerabilities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_4" />

    <!-- Empty vault: an invitation to act (no Add button in duress mode) -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_key"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/home_empty_title"
            android:textAppearance="@style/TextAppearance.Ledger.TitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/home_empty_body"
            android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_add"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/vault_add_login"
            app:icon="@drawable/ic_add" />
    </LinearLayout>
</LinearLayout>
