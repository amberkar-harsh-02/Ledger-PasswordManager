<?xml version="1.0" encoding="utf-8"?>
<!--
    Lock cover: laid over any protected screen (Vault, Add, Edit) when Ledger comes back after the
    auto-lock time. Hides the screen until the user confirms it's them; "Unlock" retries if they
    dismissed the prompt. Added by ProtectedActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_6"
    android:translationZ="100dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_lock"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:accessibilityHeading="true"
        android:text="@string/lock_cover_title"
        android:textAppearance="@style/TextAppearance.Ledger.TitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:text="@string/lock_cover_body"
        android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lock_cover_unlock"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/lock_cover_unlock"
        app:icon="@drawable/ic_fingerprint" />
</LinearLayout>
