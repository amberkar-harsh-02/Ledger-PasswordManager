<?xml version="1.0" encoding="utf-8"?>
<!-- Login detail, shown after the user unlocks a vault row. The password stays hidden until "Show". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheet_monogram"
            style="@style/Widget.Ledger.Monogram"
            android:importantForAccessibility="no"
            tools:text="G" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.Ledger.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="GitHub" />

            <TextView
                android:id="@+id/sheet_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                tools:text="harsh@example.com" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/sheet_password_label"
        android:textAppearance="@style/TextAppearance.Ledger.LabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:background="@drawable/bg_secret_field"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_1">

        <TextView
            android:id="@+id/sheet_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:breakStrategy="simple"
            android:textAppearance="@style/TextAppearance.Ledger.SecretSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="••••••••••••" />

        <Button
            android:id="@+id/sheet_toggle_password"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/sheet_show_password"
            app:icon="@drawable/ic_visibility"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_strength"
        style="@style/Widget.Ledger.StrengthLabel"
        android:layout_marginTop="@dimen/space_2"
        tools:text="Strong" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_copy"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/sheet_copy_password"
        app:icon="@drawable/ic_content_copy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_fill_computer"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/sheet_fill_on_computer"
        app:icon="@drawable/ic_qr_code_scanner" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_edit"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/sheet_edit_login"
        app:icon="@drawable/ic_edit" />
</LinearLayout>
