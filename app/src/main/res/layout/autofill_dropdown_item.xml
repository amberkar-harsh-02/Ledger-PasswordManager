<?xml version="1.0" encoding="utf-8"?>
<!--
    Autofill dropdown row (a RemoteViews, drawn by the system inside other apps).
    It is inflated outside Ledger's theme, so it must use @color / @dimen resources only,
    never ?attr references. Night colors still apply through values-night/colors.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ledger_surface_container_high"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_2">

    <ImageView
        android:id="@+id/autofill_icon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_autofill_key" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:orientation="vertical">

        <TextView
            android:id="@+id/autofill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ledger_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/autofill_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ledger_on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
