<?xml version="1.0" encoding="utf-8"?>
<!-- About: app name and version, how Ledger protects data, the browser extension, and storage -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Ledger.HeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_version_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_1"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Version 1.1.0" />

        <!-- Ledger -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/about_group_ledger" />

        <LinearLayout
            android:id="@+id/row_field_manual"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_shield" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/about_how_it_works" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/about_how_it_works_summary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_share"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_share" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/about_extension" />

                <TextView
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    android:text="@string/about_extension_summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Storage -->
        <TextView
            style="@style/Widget.Ledger.ListSubheader"
            android:text="@string/about_group_storage" />

        <LinearLayout
            android:id="@+id/row_clear_cache"
            style="@style/Widget.Ledger.SettingsRow">

            <ImageView
                style="@style/Widget.Ledger.SheetRowIcon"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_cleaning_services" />

            <LinearLayout style="@style/Widget.Ledger.SettingsRowText">

                <TextView
                    style="@style/Widget.Ledger.SettingsRowTitle"
                    android:text="@string/about_clear_cache" />

                <TextView
                    android:id="@+id/text_cache_size"
                    style="@style/Widget.Ledger.SettingsRowSummary"
                    tools:text="Temporary files: 1.2 MB. Your vault isn't affected." />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/about_credit"
            android:textAppearance="@style/TextAppearance.Ledger.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
