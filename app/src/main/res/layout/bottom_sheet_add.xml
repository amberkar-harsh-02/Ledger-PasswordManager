<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a login" choices, opened from the Vault FAB -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_4">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2"
        android:accessibilityHeading="true"
        android:paddingHorizontal="@dimen/space_6"
        android:text="@string/add_sheet_title"
        android:textAppearance="@style/TextAppearance.Ledger.TitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/btn_manual_entry"
        style="@style/Widget.Ledger.SheetRow">

        <ImageView
            style="@style/Widget.Ledger.SheetRowIcon"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_edit" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_sheet_manual_title"
                android:textAppearance="@style/TextAppearance.Ledger.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_sheet_manual_body"
                android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_generate_inject"
        style="@style/Widget.Ledger.SheetRow">

        <ImageView
            style="@style/Widget.Ledger.SheetRowIcon"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_qr_code_scanner" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_sheet_new_title"
                android:textAppearance="@style/TextAppearance.Ledger.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_sheet_new_body"
                android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
