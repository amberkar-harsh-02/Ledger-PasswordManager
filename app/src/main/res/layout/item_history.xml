<?xml version="1.0" encoding="utf-8"?>
<!-- One unlock-history entry: result icon, what happened, when -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_6"
    android:paddingVertical="@dimen/space_2">

    <ImageView
        android:id="@+id/history_icon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Ledger.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Unlocked with fingerprint" />

        <TextView
            android:id="@+id/history_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Ledger.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Sep 28, 2026, 21:14" />
    </LinearLayout>
</LinearLayout>
