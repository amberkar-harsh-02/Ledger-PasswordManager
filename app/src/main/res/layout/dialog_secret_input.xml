<?xml version="1.0" encoding="utf-8"?>
<!--
    One secret field for dialogs (backup password, duress PIN, PIN fallback); hint and input type
    set in code. The strength meter is hidden unless the caller turns it on (new backup password).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_6"
    android:paddingTop="@dimen/space_2">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_secret"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ledger_secret"
            android:importantForAutofill="no"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/strength_meter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/strength_segments"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <View style="@style/Widget.Ledger.StrengthSegment" />
            <View style="@style/Widget.Ledger.StrengthSegment" />
            <View style="@style/Widget.Ledger.StrengthSegment" />
            <View style="@style/Widget.Ledger.StrengthSegment" />
        </LinearLayout>

        <TextView
            android:id="@+id/strength_label"
            style="@style/Widget.Ledger.StrengthLabel"
            android:layout_marginStart="@dimen/space_3"
            android:accessibilityLiveRegion="polite"
            tools:text="Strong" />
    </LinearLayout>
</LinearLayout>
