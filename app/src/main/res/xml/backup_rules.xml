<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices on API 30 and below (unused while minSdk is 31, kept for safety).
   The vault, its prefs (PIN hashes) and Keystore-bound data must never leave the device.
   Use the in-app encrypted .ledger export for backups instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
