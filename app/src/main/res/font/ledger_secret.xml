<?xml version="1.0" encoding="utf-8"?>
<!--
    Face for secrets people read or copy: PIN digits, 2FA codes, revealed passwords.
    Atkinson Hyperlegible Next (Braille Institute, SIL OFL 1.1, see docs/licenses/)
    keeps 0/O and 1/l/I distinct. Bundled so nothing is fetched over the network.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/atkinson_hyperlegible_next"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/atkinson_hyperlegible_next"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
