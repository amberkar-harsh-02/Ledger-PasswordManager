<?xml version="1.0" encoding="utf-8"?>
<!-- Ledger component styles. Colors come from theme attributes, sizes from dimens.xml. -->
<resources>

    <!-- Pill-shaped filled search field with a search icon and a clear button -->
    <style name="Widget.Ledger.SearchField" parent="Widget.Material3.TextInputLayout.FilledBox.Dense">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_extra_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_extra_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_extra_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_extra_large</item>
        <!-- No floating label: the hint sits inside the field (set on the EditText) -->
        <item name="hintEnabled">false</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconMode">clear_text</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 40dp round tonal avatar with the login's first letter -->
    <style name="Widget.Ledger.Monogram" parent="">
        <item name="android:layout_width">@dimen/avatar_size</item>
        <item name="android:layout_height">@dimen/avatar_size</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_monogram</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Password strength: sentence-case words with a leading icon; tinted in code -->
    <style name="Widget.Ledger.StrengthLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/space_1</item>
        <item name="android:paddingHorizontal">@dimen/space_2</item>
        <item name="android:paddingVertical">@dimen/space_1</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.LabelLarge</item>
    </style>

    <!-- One of the 4 strength-meter segments; color set in code -->
    <style name="Widget.Ledger.StrengthSegment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/space_1</item>
        <item name="android:background">@drawable/bg_strength_segment</item>
    </style>

    <!-- Home balance legend: swatch + "29 strong" in tabular figures -->
    <style name="Widget.Ledger.LegendItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/space_5</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/space_2</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Settings screens (Security, About) -->
    <style name="Widget.Ledger.ListSubheader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:paddingHorizontal">@dimen/screen_margin</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.TitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Ledger.SettingsRow" parent="Widget.Ledger.SheetRow">
        <item name="android:paddingHorizontal">@dimen/screen_margin</item>
    </style>

    <style name="Widget.Ledger.SettingsRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/space_4</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Ledger.SettingsRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.BodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Ledger.SettingsRowSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Tappable two-line row inside a bottom sheet -->
    <style name="Widget.Ledger.SheetRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/space_6</item>
        <item name="android:paddingVertical">@dimen/space_3</item>
    </style>

    <style name="Widget.Ledger.SheetRowIcon" parent="">
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Lock screen -->
    <style name="Widget.Ledger.PinDot" parent="">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginHorizontal">@dimen/space_3</item>
        <item name="android:src">@drawable/pin_dot_empty</item>
    </style>

    <!-- Round 72dp keypad key with a digit in the Secret face -->
    <style name="Widget.Ledger.KeypadKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">@dimen/keypad_key_size</item>
        <item name="android:layout_height">@dimen/keypad_key_size</item>
        <item name="android:layout_margin">@dimen/space_2</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.Keypad</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- Keypad key holding an icon (fingerprint, backspace): same size, no fill -->
    <style name="Widget.Ledger.KeypadIconKey" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/keypad_key_size</item>
        <item name="android:layout_height">@dimen/keypad_key_size</item>
        <item name="android:layout_margin">@dimen/space_2</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>
</resources>
